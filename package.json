{
  "name": "@moto-pos/core",
  "version": "0.1.0",
  "description": "Standalone MOTO POS module for Stripe payment processing with pluggable idempotency store",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./tokens": {
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js",
      "types": "./dist/tokens/index.d.ts"
    },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./store": {
      "import": "./dist/store/index.mjs",
      "require": "./dist/store/index.js",
      "types": "./dist/store/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./strings": {
      "import": "./dist/strings/index.mjs",
      "require": "./dist/strings/index.js",
      "types": "./dist/strings/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/tokens && cp src/tokens/tokens.css dist/tokens/tokens.css",
    "dev": "vitest --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "docs:dev": "vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs && cp -r docs/api-typedoc docs/.vitepress/dist/",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc"
  },
  "peerDependencies": {
    "react": ">=19",
    "stripe": ">=22"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/pg": "^8.10.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/redis": "^4.0.11",
    "eslint": "^10.9.0",
    "pg": "^8.11.3",
    "react": "^19.2.8",
    "redis": "^4.6.10",
    "stripe": "^22.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vitepress": "^1.0.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "stripe",
    "moto",
    "pos",
    "payments",
    "vcc",
    "idempotency"
  ],
  "license": "MIT"
}
